<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Film slate / frame base in safe zone -->
    <path
        android:pathData="M32,30 h44 c3.3,0 6,2.7 6,6 v36 c0,3.3 -2.7,6 -6,6 h-44 c-3.3,0 -6,-2.7 -6,-6 v-36 c0,-3.3 2.7,-6 6,-6 z"
        android:fillColor="#1F2430"
        android:strokeWidth="2.5"
        android:strokeColor="#E50914" />

    <!-- Top film strip decorative notches -->
    <path
        android:pathData="M32,30 h44 v8 h-44 z"
        android:fillColor="#E50914" />
    <path
        android:pathData="M36,32 h4 v4 h-4 z M46,32 h4 v4 h-4 z M56,32 h4 v4 h-4 z M66,32 h4 v4 h-4 z"
        android:fillColor="#FFFFFF" />

    <!-- Stylized "TT" Typography -->
    <!-- First 'T' -->
    <path
        android:pathData="M34,44 h14 v4 h-5 v20 h-4 v-20 h-5 z"
        android:fillColor="#FFFFFF" />
    <!-- Second 'T' -->
    <path
        android:pathData="M49,44 h14 v4 h-5 v20 h-4 v-20 h-5 z"
        android:fillColor="#FFFFFF" />

    <!-- Glowing Play Triangle Accent on the right -->
    <path
        android:pathData="M66,48 L76,56 L66,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="66"
                android:startY="48"
                android:endX="76"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFD54F" />
                <item android:offset="1.0" android:color="#FF9800" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
